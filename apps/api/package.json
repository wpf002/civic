{
  "name": "@civic/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "dotenv -e ../../.env -- vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@civic/core": "workspace:*",
    "@civic/db": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "vitest": "^2.1.0",
    "typescript": "^5.6.2",
    "dotenv-cli": "^7.4.2"
  }
}
