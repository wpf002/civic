{
  "name": "@civic/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "seed:fixture": "dotenv -e ../../.env -- tsx src/seed-fixture.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@civic/core": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "dotenv-cli": "^7.4.2"
  }
}
