# Postgres (Railway provides DATABASE_URL)
DATABASE_URL=postgresql://civic:civic@localhost:5433/civic

# Flint (AI seam). Civic never calls a model vendor directly.
FLINT_BASE_URL=http://localhost:4100
FLINT_API_KEY=

# Ingest sources
OPENSTATES_API_KEY=
CONGRESS_GOV_API_KEY=
FEC_API_KEY=

# Admin auth (single shared secret for the review console in v0; replace before pilot)
ADMIN_TOKEN=change-me

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
