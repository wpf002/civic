# Postgres (Railway provides DATABASE_URL)
DATABASE_URL=postgresql://civic:civic@localhost:55432/civic

# Model seam. Only packages/extract/src/llm.ts may read these.
ANTHROPIC_API_KEY=
# Required only if the key above is identity-linked (the API returns a 400 saying so).
# Required only when the key above is identity-linked (not scoped to one workspace).
# The SDK does not read this on the API-key path, so llm.ts sends it as a header.
ANTHROPIC_WORKSPACE_ID=
# Two independent models for the extraction reconcile. Must not be the same model.
EXTRACT_MODEL_A=claude-opus-5
EXTRACT_MODEL_B=claude-sonnet-5

# Ingest sources
OPENSTATES_API_KEY=
CONGRESS_GOV_API_KEY=
FEC_API_KEY=

# Admin auth (single shared secret for the review console in v0; replace before pilot)
# The admin routes refuse to start on the literal value "change-me".
# The admin routes refuse to start on the literal value below. Set a real secret.
ADMIN_TOKEN=change-me

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3007

# Ingest
# Adapters fetch public pages; no key is required for any pilot source.
